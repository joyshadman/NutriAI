# Copy this file to .env.local and fill in the values.
# .env.local is git ignored and never committed.

# Postgres (Neon). Create a project at https://neon.tech and paste the
# pooled connection string.
#
# DATABASE_URL belongs to the app role, a non owner role that is subject to row
# level security. Create it once in the Neon console (SQL editor):
#
#   CREATE ROLE nutriai_app LOGIN PASSWORD '<a long random password>';
#
# Then connect with that role's pooled string. The policies are in
# db/migrations/*_rls_policies.sql.
DATABASE_URL=

# Owner connection string, used only by `npm run db:migrate`. Never used by the
# running app.
MIGRATION_DATABASE_URL=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth only. Create credentials at
# https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenRouter. Free model first, cheap paid model as the fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini

# Vercel Blob, for meal photos.
BLOB_READ_WRITE_TOKEN=

# Upstash Redis, for rate limiting. Leave empty to allow every request.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limit per identity (user id or IP address) on the AI endpoints.
AI_RATE_LIMIT=20
AI_RATE_WINDOW_SECONDS=60
